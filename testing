unanchorCorner.CornerRadius = UDim.new(0, 7)
unanchorCorner.Parent = unanchor

local anchored = false

-- ANCHOR ALL
anchor.MouseButton1Click:Connect(function()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            obj.Anchored = true
        end
    end

    anchored = true
    anchor.Text = "⚓  ANCHOR ALL  •  ON"
    anchor.BackgroundColor3 = Color3.fromRGB(70, 70, 70)
end)

-- UNANCHOR ALL
unanchor.MouseButton1Click:Connect(function()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            obj.Anchored = false
        end
    end

    anchored = false
    anchor.Text = "⚓  ANCHOR ALL  •  OFF"
    anchor.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
end)
