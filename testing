--==================================================
-- CEK APAKAH OBJEK HARUS DIABAIKAN
--==================================================

local function shouldIgnore(obj)

    -- Baseplate
    if obj.Name:lower() == "baseplate" then
        return true
    end

    -- SpawnLocation
    if obj:IsA("SpawnLocation") then
        return true
    end

    -- Character / NPC yang mempunyai Humanoid
    local parent = obj.Parent

    while parent and parent ~= workspace do

        if parent:IsA("Model") then

            if parent:FindFirstChildOfClass("Humanoid") then
                return true
            end

        end

        parent = parent.Parent
    end

    return false
end

--==================================================
-- CARI PART MAP
--==================================================

local function getMapParts()

    local result = {}

    for _,obj in ipairs(workspace:GetDescendants()) do

        if obj:IsA("BasePart") then

            if not shouldIgnore(obj) then
                table.insert(result,obj)
            end

        end

    end

    return result
end

--==================================================
-- ANCHOR ALL
--==================================================

local function anchorAll()

    local parts = getMapParts()
    local count = 0

    for _,part in ipairs(parts) do

        pcall(function()

            part.Anchored = true

            -- memastikan property benar-benar berubah
            if part.Anchored == true then
                count += 1
            end

        end)

    end

    return count
end

--==================================================
-- UNANCHOR ALL
--==================================================

local function unanchorAll()

    local parts = getMapParts()
    local count = 0

    for _,part in ipairs(parts) do

        pcall(function()

            part.Anchored = false

            if part.Anchored == false then
                count += 1
            end

        end)

    end

    return count
end

