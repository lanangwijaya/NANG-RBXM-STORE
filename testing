    local function insertObjs(objs, isRbxl, smap)
        local cnt = 0
        for _, obj in ipairs(objs) do
            pcall(function()
                local t = (isRbxl and (SVC[obj.ClassName] or SVC[obj.Name])) or workspace
                if t == workspace and obj:IsA("Service") then t = RS end
                if isRbxl and t ~= workspace then
                    for _, c in ipairs(obj:GetChildren()) do
                        pcall(function()
                            c.Parent = t; injectAll(c, smap); applyProps(c); loadAssetsSL(c)
                            cnt = cnt + 1
                        end)
                        task.wait(0.01)
                    end
                else
                    obj.Parent = t; injectAll(obj, smap); applyProps(obj); loadAssetsSL(obj)
                    cnt = cnt + 1
                end
            end)
        end
        return cnt
    end
    local function readFile(p)
        if type(readfile) ~= "function" then return nil end
        local ok, d = pcall(readfile, p)
        if ok and type(d)=="string" and #d>0 then return d end
        return nil
    end
    local function normPath(p)
        p = tostring(p or ""):gsub("^%s+",""):gsub("%s+$","")
        p = p:gsub("^file://","")
        p = p:gsub("^[\"']",""):gsub("[\"']$","")
        return p
    end
    local function getCustomAsset(p)
        local fns = {}
        if type(getcustomasset) == "function" then table.insert(fns, getcustomasset) end
        if type(getsynasset) == "function" then table.insert(fns, getsynasset) end
        for _, fn in ipairs(fns) do
            local ok, a = pcall(fn, p)
            if ok and type(a)=="string" and a ~= "" then return a end
        end
        return nil
    end
    local function loadFile(info)
        local isRbxl = info.ftype == "RBXL"
        local path = normPath(info.path)
        if path == "" then return false, "Path kosong" end
        local data = readFile(path)
        if not data then return false, "File tidak terbaca: "..path end
        if not isRbxl and data:sub(1,8) ~= "<roblox!" then
            return false, "File bukan RBXM/RBXMX valid"
        end
        local smap = {}
        if not isRbxl then
            local ok, s = pcall(parseRBXM, data)
            if ok and type(s)=="table" then smap = s end
        end
        local assetUri = getCustomAsset(path)
        if assetUri then
            local ok, objs = pcall(function() return game:GetObjects(assetUri) end)
            if ok and type(objs)=="table" and #objs>0 then
                for _, o in ipairs(objs) do captureSrc(o) end
                local cnt = insertObjs(objs, isRbxl, smap)
                if cnt > 0 then return true, cnt.." object dimuat" end
                return false, "Object tidak bisa dimasukkan"
            end
        end
        -- Fallback rbxasset
        local ok2, objs2 = pcall(function() return game:GetObjects("rbxasset://"..path) end)
        if ok2 and type(objs2)=="table" and #objs2>0 then
            for _, o in ipairs(objs2) do captureSrc(o) end
            local cnt = insertObjs(objs2, isRbxl, smap)
            if cnt > 0 then return true, cnt.." object dimuat" end
        end
        return false, "Executor tidak support getcustomasset atau file gagal dibuka"
    end

