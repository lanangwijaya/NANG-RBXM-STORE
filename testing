-- REMOTE MAPPER — hook __namecall, log semua call + args
-- cara pakai: execute → main game biasa → cek console (F9)
-- ═══════════════════════════════════════════════════════════════════════
local RS = game:GetService("ReplicatedStorage")

-- ── 1. list semua remote yang ada sekarang ────────────────────────────
print("\n=== STATIC REMOTE LIST ===")
local function walk(parent, depth)
    for _, obj in ipairs(parent:GetChildren()) do
        if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
            print(string.rep("  ", depth) .. "[" .. obj.ClassName:sub(1,3) .. "] " .. obj.Name .. "  @ " .. obj:GetFullName())
        end
        if #obj:GetChildren() > 0 and depth < 5 then walk(obj, depth + 1) end
    end
end
walk(RS, 0)
walk(workspace, 0)

-- ── 2. hook __namecall — log semua FireServer/InvokeServer ────────────
if not getrawmetatable or not setreadonly then
    warn("executor lu nggak support getrawmetatable/setreadonly — hook dilewat")
    return
end

local seen = {}
local startTime = os.clock()

local function logCall(self, method, args, argCount)
    local full = (pcall(function() return self:GetFullName() end) and self:GetFullName()) or self.Name
    local key = full .. "|" .. method

    -- summary args
    local parts = {}
    for i = 1, argCount do
        local v = args[i]
        local tv = type(v)
        if tv == "string" then
            parts[i] = string.format("%q", v)
        elseif tv == "number" or tv == "boolean" then
            parts[i] = tostring(v)
        elseif tv == "Instance" then
            parts[i] = "<" .. v.ClassName .. ":" .. v.Name .. ">"
        elseif tv == "Vector3" then
            parts[i] = string.format("V3(%.1f,%.1f,%.1f)", v.X, v.Y, v.Z)
        elseif tv == "Vector2" then
            parts[i] = string.format("V2(%.1f,%.1f)", v.X, v.Y)
        elseif tv == "CFrame" then
            parts[i] = "CFrame"
        elseif tv == "table" then
            local t = {}
            local n = 0
            for k, vv in pairs(v) do
                n = n + 1
                if n > 5 then t[#t+1] = "..."; break end
                local kt = type(k)
                local vt = type(vv)
                if kt == "string" or kt == "number" then
                    if vt == "string" or vt == "number" or vt == "boolean" then
                        t[#t+1] = tostring(k) .. "=" .. tostring(vv)
                    else
                        t[#t+1] = tostring(k) .. "=<" .. vt .. ">"
                    end
                else
                    t[#t+1] = "<" .. kt .. ">"
                end
            end
            parts[i] = "{" .. table.concat(t, ",") .. "}"
        else
            parts[i] = "<" .. tv .. ">"
        end
    end
    local argStr = table.concat(parts, ", ")

    -- print pertama kali + hitungan
    if not seen[key] then
        seen[key] = { count = 1, firstAt = os.clock() - startTime, sample = argStr }
        print(string.format("\n[NEW] %s:%s(%s)", full, method, argStr))
    else
        seen[key].count = seen[key].count + 1
        -- print ulang kalau argumen berubah
        if seen[key].sample ~= argStr then
            print(string.format("[%s#%d] %s(%s)", full:match("([^%.]+)$"), seen[key].count, method, argStr))
            seen[key].sample = argStr
        end
    end
end

local mt = getrawmetatable(game)
local oldNamecall = mt.__namecall
setreadonly(mt, false)
mt.__namecall = newcclosure(function(self, ...)
    local method = getnamecallmethod()
    if (method == "FireServer" or method == "InvokeServer")
    and typeof(self) == "Instance"
    and (self:IsA("RemoteEvent") or self:IsA("RemoteFunction")) then
        pcall(logCall, self, method, {...}, select("#", ...))
    end
    return oldNamecall(self, ...)
end)
setreadonly(mt, true)

print("\n=== HOOK AKTIF ===")
print("mancing manual / main game biasa, console bakal print tiap remote call")
print("ketik: _G.REMOTE_MAP() di console buat lihat summary")
print("ketik: _G.REMOTE_MAP_RESET() buat reset counter\n")

-- ── 3. summary helper ─────────────────────────────────────────────────
_G.REMOTE_MAP = function()
    print("\n=== REMOTE CALL SUMMARY ===")
    local list = {}
    for k, v in pairs(seen) do
        table.insert(list, { key = k, count = v.count, sample = v.sample })
    end
    table.sort(list, function(a, b) return a.count > b.count end)
    for i, e in ipairs(list) do
        print(string.format("[%3d calls] %s  |  sample: %s", e.count, e.key, e.sample))
    end
    print("=== end ===\n")
end

_G.REMOTE_MAP_RESET = function()
    for k in pairs(seen) do seen[k] = nil end
    startTime = os.clock()
    print("[mapper] reset")
end
