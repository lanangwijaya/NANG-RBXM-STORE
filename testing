    local function readSrc(scr)
        local s
        pcall(function() s = scr.Source end)
        if not s or #tostring(s)==0 then pcall(function() s = scr.ContentText end) end
        if s and type(s)=="string" and #s>0 then return s:gsub(string.char(0).."*$","") end
        return nil
    end
    local function captureSrc(root)
        if not root then return 0 end
        local n = 0
        local function cap(o)
            if not o or not o:IsA("LuaSourceContainer") then return end
            local s = readSrc(o)
            if s then _G.LANGZ_RAW_SOURCES[o] = s; n = n + 1 end
        end
        cap(root)
        for _, d in ipairs(root:GetDescendants()) do cap(d) end
        return n
    end
    local function injectSL(scr, smap)
        if not scr:IsA("LuaSourceContainer") then return false end
        local src = readSrc(scr) or _G.LANGZ_RAW_SOURCES[scr]
        if not src or #src==0 then src = "-- [NANG] Source tidak ditemukan." end
        src = src:gsub(string.char(0).."*$","")
        _G.LANGZ_RAW_SOURCES[scr] = src
        local txt = src
        if #txt > 150000 then txt = "-- [NANG] Dipotong\n\n"..string.sub(txt,1,150000).."\n\n... [TERPOTONG]" end
        local ex = scr:FindFirstChild("SL_CodeTextBox")
        if ex then
            ex.Text = txt
            if scr.ClassName == "ModuleScript" then
                local ro = scr:FindFirstChild("SL_1ReadOnly")
                if ro then ro.ContentText = txt; ro.Text = txt end
            end
            return true
        end
        if not serverFuncs then return false end
        local map = {Script="InsertScriptScript", LocalScript="InsertLocalScriptLocalScript", ModuleScript="InsertModuleScriptModuleScript"}
        local an = map[scr.ClassName]
        if not an then return false end
        if not SL_CACHE[an] then
            pcall(function()
                serverFuncs:InvokeServer("LoadAssetToPlayerGui", an)
                local gf = LP:WaitForChild("PlayerGui"):WaitForChild(an, 3)
                if gf then
                    SL_CACHE[an] = {}
                    for _, c in ipairs(gf:GetChildren()) do table.insert(SL_CACHE[an], c:Clone()) end
                    serverFuncs:InvokeServer("ClearAssetFromPlayerGui", an)
                end
            end)
        end
        if not SL_CACHE[an] then return false end
        local ok = pcall(function()
            for _, c in ipairs(SL_CACHE[an]) do c:Clone().Parent = scr end
            local tb = scr:FindFirstChild("SL_CodeTextBox")
            if tb then
                tb.Text = txt
                if scr.ClassName == "ModuleScript" then
                    local ro = scr:FindFirstChild("SL_1ReadOnly")
                    if ro then ro.ContentText = txt; ro.Text = txt end
                end
            end
        end)
        return ok
    end
    local function injectAll(root, smap)
        if not root then return 0 end
        local list = {}
        if root:IsA("LuaSourceContainer") then table.insert(list, root) end
        for _, d in ipairs(root:GetDescendants()) do
            if d:IsA("LuaSourceContainer") then table.insert(list, d) end
        end
        local ok = 0
        for _, s in ipairs(list) do
            local r = pcall(injectSL, s, smap)
            if r then ok = ok + 1 end
            task.wait(0.01)
        end
        return ok
    end
    local function applyProps(obj)
        if not obj then return end
        pcall(function()
            if obj:IsA("BasePart") then
                obj.Anchored = true
            end
        end)
        for _, c in ipairs(obj:GetChildren()) do applyProps(c) end
    end
    local function loadAssetsSL(obj)
        local function scan(n)
            pcall(function()
                if n:IsA("MeshPart") then triggerLoad(n.MeshId); triggerLoad(n.TextureID)
                elseif n:IsA("Decal") or n:IsA("Texture") then triggerLoad(n.Texture)
                elseif n:IsA("SpecialMesh") then triggerLoad(n.MeshId); triggerLoad(n.TextureId)
                elseif n:IsA("Clothing") or n:IsA("ShirtGraphic") then
                    triggerLoad(n.ClassName=="ShirtGraphic" and n.Graphic or n[n.ClassName.."Template"])
                elseif n:IsA("UnionOperation") or n:IsA("PartOperation") then triggerLoad(n.AssetId) end
            end)
            for _, c in ipairs(n:GetChildren()) do scan(c) end
        end
        scan(obj)
    end
