    -- FILE SCAN
    -- ═══════════════════════════════════════════════════════════════════
    local function listDir(p)
        if not listfiles then return nil end
        local ok, f = pcall(listfiles, p)
        if ok and type(f)=="table" then return f end
        return nil
    end
    local function fname(p) return p:match("([^/]+)$") or p end
    local function ftype(n)
        n = n:lower()
        if n:match("%.rbxl") or n:match("%.rbxlx") then return "RBXL" end
        if n:match("%.rbxm") or n:match("%.rbxmx") then return "RBXM" end
        return nil
    end
    local function isFolder(p) return not fname(p):match("%.[%a%d]+") end

    local SCAN_PATHS = {
        "workspace", "Delta/workspace", "delta/workspace",
        "/sdcard/Delta/workspace", "/sdcard/Android/Delta/workspace",
        "/sdcard/Download", "/sdcard/Downloads",
        "/storage/emulated/0/Download", "/storage/emulated/0/Downloads",
        "/storage/emulated/0/Delta/workspace",
        "../workspace", "."
    }
    local function scanDeep(folder, depth, res, seen)
        if depth > 4 or seen[folder] then return end
        seen[folder] = true
        local list = listDir(folder)
        if not list then return end
        for _, path in ipairs(list) do
            local nm = fname(path); local ft = ftype(nm)
            if ft and not seen[path] then
                seen[path] = true
                table.insert(res, {name=nm, path=path, ftype=ft, folder=folder})
            elseif isFolder(path) then
                scanDeep(path, depth+1, res, seen)
            end
        end
    end
    local function scanAll()
        local res, seen = {}, {}
        for _, p in ipairs(SCAN_PATHS) do
            if listDir(p) then scanDeep(p, 0, res, seen) end
        end
        return res
    end

