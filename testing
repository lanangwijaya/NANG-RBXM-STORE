local function nangGetTimeWindow()
    return math.floor(os.time() / 86400)
end

local function nangSimpleHash(str)
    local h = 0
    for i = 1, #str do h = (h * 31 + string.byte(str, i)) % 1000000007 end
    return h
end

local function nangGenerateKey(userId, window)
    local raw = NANG_KEY_SECRET .. tostring(userId) .. tostring(window)
    local h = nangSimpleHash(raw)
    local uid = tostring(userId)
    local p1 = uid:sub(1, math.min(5, #uid))
    while #p1 < 5 do p1 = p1 .. "0" end
    local p2 = string.format("%04d", h % 10000)
    local p3 = string.format("%04d", math.floor(h / 10000) % 10000)
    return "NANG-" .. p1 .. "-" .. p2 .. "-" .. p3
end

local function nangValidateKey(userId, key)
    local w = nangGetTimeWindow()
    local input = string.upper(tostring(key)):gsub("%s+", "")
    return (input == nangGenerateKey(userId, w))
        or (input == nangGenerateKey(userId, w - 1))
end

