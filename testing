-- SCAN LOGIC
-- ═══════════════════════════════════════════════════════════════════════
ScanClick.MouseButton1Click:Connect(function()
    if ActivePage ~= "RBXM" and ActivePage ~= "RBXMX" then
        showPage("RBXM")
    end
    ScanText.Text = "↻  SCANNING..."
    clearScrollCards()
    SearchEmptyFrame.Visible = true
    SearchEmptyFrame:FindFirstChildOfClass("TextLabel").Text = "⏳ Mencari file RBXM / RBXMX / RBXL di HP kamu..."
    StatsText.Text = "Status: Scanning file..."

    task.spawn(function()
        local scanned = scanAll()
        local foundFiles = {}
        for _, f in ipairs(scanned) do
            if ActivePage == "RBXMX" then
                if f.path:lower():match("%.rbxmx$") then table.insert(foundFiles, f) end
            elseif ActivePage == "RBXM" then
                if f.path:lower():match("%.rbxm$") then table.insert(foundFiles, f) end
            else
                table.insert(foundFiles, f)
            end
        end
        for _, f in ipairs(foundFiles) do buildModernFileCard(f) end
        SearchEmptyFrame.Visible = (#foundFiles == 0)
        if #foundFiles == 0 then
            SearchEmptyFrame:FindFirstChildOfClass("TextLabel").Text = "Tidak ada file " .. ActivePage .. " ditemukan.\n\nTaruh file di /sdcard/Download lalu scan lagi."
        end
        StatsText.Text = string.format("Status: %d %s file(s) ditemukan", #foundFiles, ActivePage)
        ScanText.Text = "↻  SCAN FILES"
        if #foundFiles == 0 then
            notify("Scan Selesai", "Tidak ada file ditemukan.", Color3.fromRGB(220,200,150))
        else
            notify("Scan Selesai", #foundFiles .. " file ditemukan.", Color3.fromRGB(150,200,150))
        end
    end)
end)

