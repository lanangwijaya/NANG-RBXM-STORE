local function showPage(page)
    ActivePage = page
    local indexMap = {DASHBOARD=1, TOOLBOX=2, RBXM=3, RBXMX=4, SETTINGS=5, CREDITS=6}
    setSideActive(indexMap[page] or 2)

    if ScanBtn then
        ScanBtn.Visible = (page == "RBXM" or page == "RBXMX")
    end

    if page == "TOOLBOX" then
        PageTitle.Text = "🔍  Toolbox"
        PageSubtitle.Text = "Cari model, decal, atau audio di Creator Store lalu tekan INSERT."
        SearchRow.Visible = true
        TypeTabs.Visible = true
        SearchHead.Visible = true
        SearchScroll.Visible = true
        PagePanel.Visible = false
    elseif page == "DASHBOARD" then
        PageTitle.Text = "🏠  Beranda"
        PageSubtitle.Text = "Selamat datang. Pilih menu di kiri untuk mulai."
        SearchRow.Visible = false
        TypeTabs.Visible = false
        SearchHead.Visible = false
        SearchScroll.Visible = false
        if showDashboardPanel then showDashboardPanel() end
        PagePanel.Visible = true
    elseif page == "RBXM" or page == "RBXMX" then
        PageTitle.Text = (page == "RBXM") and "📦  File RBXM" or "📄  File RBXMX"
        PageSubtitle.Text = "Tekan SCAN FILES di sidebar bawah untuk mencari file di HP kamu."
        SearchRow.Visible = false
        TypeTabs.Visible = false
        SearchHead.Visible = true
        SearchScroll.Visible = true
        SearchHead.Text = "   DAFTAR FILE " .. page .. " DI HP KAMU"
        PagePanel.Visible = false
    elseif page == "SETTINGS" then
        PageTitle.Text = "⚙️  Pengaturan"
        PageSubtitle.Text = "Ubah perilaku UI sesuai kebutuhan."
        SearchRow.Visible = false
        TypeTabs.Visible = false
        SearchHead.Visible = false
        SearchScroll.Visible = false
        if showSettingsPanel then showSettingsPanel() end
        PagePanel.Visible = true
    elseif page == "CREDITS" then
        PageTitle.Text = "ℹ️  Tentang"
        PageSubtitle.Text = "Informasi script dan pembuat."
        SearchRow.Visible = false
        TypeTabs.Visible = false
        SearchHead.Visible = false
        SearchScroll.Visible = false
        if showCreditsPanel then showCreditsPanel() end
        PagePanel.Visible = true
    end
end

