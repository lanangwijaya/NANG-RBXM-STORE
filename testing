FireAll.MouseButton1Click:Connect(function()
    print("[scanner] FIRE ALL — " .. #remotes .. " remotes")
    for _, r in ipairs(remotes) do
        pcall(function()
            if r:IsA("RemoteEvent") then
                r:FireServer()
            else
                task.spawn(function() r:InvokeServer() end)
            end
        end)
        task.wait(0.08)
    end
    print("[scanner] done")
end)

-- ═══════════════════════════════════════════════════════════════════════
-- SPAM TOGGLE
-- ═══════════════════════════════════════════════════════════════════════
SpamBtn.MouseButton1Click:Connect(function()
    spamOn = not spamOn
    if spamOn then
        SpamBtn.Text = "SPAM: ON"
        SpamBtn.BackgroundColor3 = Color3.fromRGB(140, 40, 40)
        print("[scanner] spam ON")
        spamThread = task.spawn(function()
            while spamOn do
                for _, r in ipairs(remotes) do
                    if not spamOn then break end
                    pcall(function()
                        if r:IsA("RemoteEvent") then
                            r:FireServer()
                        else
                            task.spawn(function() r:InvokeServer() end)
                        end
                    end)
                    task.wait(0.05)
                end
            end
        end)
    else
        SpamBtn.Text = "SPAM: OFF"
        SpamBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
        print("[scanner] spam OFF")
    end
end)

-- ═══════════════════════════════════════════════════════════════════════
-- AUTO SCAN
-- ═══════════════════════════════════════════════════════════════════════
scanNow()

-- re-scan tiap 5 detik buat nangkep remote baru
task.spawn(function()
    while GUI.Parent do
        task.wait(5)
        if not spamOn then
            local before = #remotes
            local newOnes = {}
            local function walk(parent)
                for _, obj in ipairs(parent:GetDescendants()) do
                    if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
                        local found = false
                        for _, r in ipairs(remotes) do
                            if r == obj then found = true; break end
                        end
                        if not found then table.insert(newOnes, obj) end
                    end
                end
            end
            walk(RS)
            walk(workspace)
            for _, r in ipairs(newOnes) do
                table.insert(remotes, r)
                buildRow(r)
            end
            if #newOnes > 0 then
                print(string.format("[scanner] +%d new remotes", #newOnes))
                updateCount()
            end
        end
    end
end)

print("[scanner] loaded — " .. #remotes .. " remotes")
