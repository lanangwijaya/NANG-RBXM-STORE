-- ═══════════════════════════════════════
-- HTTP
-- ═══════════════════════════════════════
local function httpGet(url, opts)
    opts = opts or {}
    local fns = {
        function() if syn and syn.request then local r = syn.request({Url=url,Method="GET"}); return r and r.Body end end,
        function() if request then local r = request({Url=url,Method="GET"}); return r and r.Body end end,
        function() if http_request then local r = http_request({Url=url,Method="GET"}); return r and r.Body end end,
        function() return game:HttpGet(url, true) end,
    }
    for _, fn in ipairs(fns) do
        local ok, r = pcall(fn)
        if ok and r and type(r) == "string" and #r > 0 then return r end
    end
    return nil
end

local function httpDownload(url)
    local fns = {
        function() if syn and syn.request then local r = syn.request({Url=url,Method="GET"}); return r and r.Body end end,
        function() if request then local r = request({Url=url,Method="GET"}); return r and r.Body end end,
        function() if http_request then local r = http_request({Url=url,Method="GET"}); return r and r.Body end end,
    }
    for _, fn in ipairs(fns) do
        local ok, r = pcall(fn)
        if ok and r and type(r) == "string" and #r > 0 then return r end
    end
    return nil
end

-- ═══════════════════════════════════════
-- Executor capability probes
-- ═══════════════════════════════════════
local function probe()
    local caps = {}
    caps.getcustomasset = type(getcustomasset) == "function" or (syn and type(syn.getcustomasset) == "function") or type(getsynasset) == "function"
    caps.setfflag       = type(setfflag) == "function" or (syn and type(syn.setfflag) == "function")
    caps.getfflag       = type(getfflag) == "function"
    caps.setrawmeta     = type(setrawmetatable) == "function"
    caps.getrawmeta     = type(getrawmetatable) == "function"
    caps.writefile      = type(writefile) == "function"
    caps.readfile       = type(readfile) == "function"
    caps.openURL        = type(openURL) == "function" or (syn and type(syn.openurl) == "function")
    caps.webview        = (syn and type(syn.webview) == "table") or type(WebView) == "table"
    caps.fireclick      = type(fireclickdetector) == "function"
    caps.sethidden      = type(sethiddenproperty) == "function"
    caps.setrawprop     = type(sethiddenproperty) == "function" or (syn and type(syn.setrawmetatable) == "function")
    caps.newcclosure    = type(newcclosure) == "function"
    caps.hookfunc       = type(hookfunction) == "function"
    caps.hookmeta       = type(hookmetamethod) == "function"
    caps.loadstring     = type(loadstring) == "function"
    caps.loadfile       = type(loadfile) == "function"
    caps.base64decode   = type(base64decode) == "function"
    caps.zstd           = type(zstd) == "table" or type(zstddecode) == "function"
    return caps
end

local function toCustomAsset(path)
    local fs = {
        type(getcustomasset) == "function" and getcustomasset or nil,
        syn and type(syn.getcustomasset) == "function" and syn.getcustomasset or nil,
        type(getsynasset) == "function" and getsynasset or nil,
    }
    for _, fn in ipairs(fs) do
        if fn then
            local ok, r = pcall(fn, path)
            if ok and type(r) == "string" and r ~= "" then return r end
        end
    end
    return nil
end

-- ═══════════════════════════════════════
-- Fetch TikTok metadata
-- ═══════════════════════════════════════
local function fetchOne(input)
    input = tostring(input or ""):gsub("^%s+",""):gsub("%s+$","")
    if input == "" then return false, "Kosong" end

    local endpoint
    if input:match("^vt%.tiktok%.com") or input:match("^vm%.tiktok%.com") then
        endpoint = API .. "?url=" .. HttpService:UrlEncode("https://" .. input)
    elseif input:match("^https?://") then
        endpoint = API .. "?url=" .. HttpService:UrlEncode(input)
    else
        endpoint = API .. "?unique_id=" .. HttpService:UrlEncode(input:gsub("^@","")) .. "&count=1"
    end

    local body = httpGet(endpoint)
    if not body then return false, "Gagal konek" end
    local ok, d = pcall(function() return HttpService:JSONDecode(body) end)
    if not ok or type(d) ~= "table" then return false, "Response invalid" end
    if d.code ~= 0 then return false, tostring(d.msg or "err " .. tostring(d.code)) end
    local data = d.data
    if type(data) == "table" and type(data.videos) == "table" and data.videos[1] then
        return true, data.videos[1]
    end
    return true, data
end

