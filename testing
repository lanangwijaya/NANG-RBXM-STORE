    d.Font=Enum.Font.Gotham; d.TextSize=7; d.TextWrapped=true; d.TextXAlignment=Enum.TextXAlignment.Left
    task.spawn(function()
        task.wait(2.5)
        for n=1,12 do
            local tr=n/12
            notif.BackgroundTransparency=tr; t.TextTransparency=tr; d.TextTransparency=tr; st.Transparency=tr
            task.wait(.02)
        end
        notif:Destroy()
    end)
end

