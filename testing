--==================================================
-- ANCHOR ALL
--==================================================

AnchorAll.MouseButton1Click:Connect(function()

    local count = 0

    for _,obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            pcall(function()
                obj.Anchored = true
                count += 1
            end)
        end
    end

    Status.Text = "Anchored: "..count.." parts"

end)

--==================================================
-- SELECT SYSTEM
--==================================================

local SelectMode = false
local SelectedObject = nil
local Mouse = Player:GetMouse()

local Highlight = Instance.new("Highlight")
Highlight.FillTransparency = 0.75
Highlight.OutlineTransparency = 0
Highlight.Enabled = false
Highlight.Parent = Workspace

SelectButton.MouseButton1Click:Connect(function()

    SelectMode = not SelectMode

    if SelectMode then
        SelectButton.Text = "SELECT MODE : ON"
        SelectButton.TextColor3 = Color3.fromRGB(255,255,255)
        Status.Text = "Tap / click an object"
    else
        SelectButton.Text = "SELECT MODE : OFF"
        SelectButton.TextColor3 = Color3.fromRGB(150,150,150)

        SelectedObject = nil
        Highlight.Adornee = nil
        Highlight.Enabled = false

        Status.Text = "Ready"
    end

end)

--==================================================
-- CLICK / TAP OBJECT
--==================================================

Mouse.Button1Down:Connect(function()

    if not SelectMode then
        return
    end

    local Target = Mouse.Target

    if not Target then
        return
    end

    -- Cari Model terdekat jika Part berada di dalam Model
    local Object = Target

    local Model = Target:FindFirstAncestorOfClass("Model")

    if Model then
        Object = Model
    end

    SelectedObject = Object

    Highlight.Adornee = Object
    Highlight.Enabled = true

    Status.Text = "Selected: "..Object.Name

end)

--==================================================
-- UNANCHOR SELECTED
--==================================================

UnanchorSelected.MouseButton1Click:Connect(function()

    if not SelectedObject then
        Status.Text = "No object selected"
        return
    end

    local count = 0

    if SelectedObject:IsA("BasePart") then

        pcall(function()
            SelectedObject.Anchored = false
            count += 1
        end)

    end

    for _,obj in ipairs(SelectedObject:GetDescendants()) do

        if obj:IsA("BasePart") then

            pcall(function()
                obj.Anchored = false
                count += 1
            end)

        end

    end

    Status.Text = "Unanchored: "..count.." parts"

end)

--==================================================
-- MINIMIZE
--==================================================

local Minimized = false

Minimize.MouseButton1Click:Connect(function()

    Minimized = not Minimized

    if Minimized then

        Main.Size = UDim2.fromOffset(170,45)

        Title.Text = "ANCHOR • BY NANG"

        By.Visible = false
        Status.Visible = false
        AnchorAll.Visible = false
        UnanchorSelected.Visible = false
        SelectButton.Visible = false

        Minimize.Text = "+"

    else

        Main.Size = UDim2.fromOffset(245,190)

        Title.Text = "ANCHOR CONTROL"

        By.Visible = true
        Status.Visible = true
        AnchorAll.Visible = true
        UnanchorSelected.Visible = true
        SelectButton.Visible = true

        Minimize.Text = "—"

    end

end)

--==================================================
-- DRAG UI
--==================================================

local Dragging = false
local DragStart
local StartPos

Title.InputBegan:Connect(function(input)

    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then

        Dragging = true
        DragStart = input.Position
        StartPos = Main.Position

    end

end)

UserInputService.InputChanged:Connect(function(input)

    if not Dragging then
        return
    end

    if input.UserInputType == Enum.UserInputType.MouseMovement
    or input.UserInputType == Enum.UserInputType.Touch then

        local Delta = input.Position - DragStart

        Main.Position = UDim2.new(
            StartPos.X.Scale,
            StartPos.X.Offset + Delta.X,
            StartPos.Y.Scale,
            StartPos.Y.Offset + Delta.Y
        )

    end

end)

UserInputService.InputEnded:Connect(function(input)

    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then

        Dragging = false

    end

end)

