    "Iron Rod", "Steel Rod", "Silver Rod", "Wooden Rod",
    -- lowercase variants
    "divine rod", "god rod", "mythical rod", "legendary rod",
    "admin rod", "owner rod", "dev rod",
    -- underscore variants
    "Divine_Rod", "God_Rod", "Mythical_Rod", "Legendary_Rod",
