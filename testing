-- ═══════════════════════════════════════════════════════════════════════
-- 3. HOOK — log semua remote call buat catch pattern server-side
-- ═══════════════════════════════════════════════════════════════════════
local CALL_LOG = {}
if getrawmetatable and setreadonly then
    local mt = getrawmetatable(game)
    local oldNC = mt.__namecall
    setreadonly(mt, false)
    mt.__namecall = newcclosure(function(self, ...)
        local method = getnamecallmethod()
        if (method == "FireServer" or method == "InvokeServer")
        and typeof(self) == "Instance"
        and (self:IsA("RemoteEvent") or self:IsA("RemoteFunction")) then
            table.insert(CALL_LOG, {
                name = self.Name,
                args = {...},
                argc = select("#", ...),
                time = os.clock(),
            })
            -- kalau ini rod remote yang kita belum tau argumennya, catet
            for _, r in ipairs(rodRemotes) do
                if r == self then
                    local argStr = ""
                    for i = 1, select("#", ...) do
                        local v = select(i, ...)
                        argStr = argStr .. type(v) .. ":" .. tostring(v):sub(1, 30) .. " "
                    end
                    print("[ROD-CALL] " .. self.Name .. "(" .. argStr .. ")")
                end
            end
        end
        return oldNC(self, ...)
    end)
    setreadonly(mt, true)
end

