        Services.RunService.RenderStepped:Connect(function()
            CrosshairFrame.Visible = Toggles.Crosshair

            if Toggles.Aimbot and Aiming then
                local targetHead = nil
                local dist = Values.AimFOV
                local mousePos = Services.UserInputService:GetMouseLocation()
                for _, plr in pairs(Services.Players:GetPlayers()) do
                    if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("Head") and plr.Character:FindFirstChild("Humanoid") and plr.Character.Humanoid.Health > 0 then
                        local screenPos, onScreen = workspace.CurrentCamera:WorldToViewportPoint(plr.Character.Head.Position)
                        if onScreen then
                            local mag = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                            if mag < dist then 
                                dist = mag 
                                targetHead = plr.Character.Head 
                            end
                        end
                    end
                end
                if targetHead then 
                    workspace.CurrentCamera.CFrame = CFrame.new(workspace.CurrentCamera.CFrame.Position, targetHead.Position) 
                end
            end

            if Toggles.SpectateTarget then
                local target = GetTargetPlayer()
                if target and target.Character and target.Character:FindFirstChild("Humanoid") then
                    workspace.CurrentCamera.CameraSubject = target.Character.Humanoid
                end
            end

            ESPWorldFolder:ClearAllChildren()
            ESPBillboardFolder:ClearAllChildren()
            for _, child in ipairs(ESPTracerContainer:GetChildren()) do
                child:Destroy()
            end

            if Toggles.ESP or Toggles.Tracers or Toggles.ESPTarget or Toggles.ESPInfo then
                local camera = workspace.CurrentCamera
                local viewport = camera and camera.ViewportSize
                for _, plr in pairs(Services.Players:GetPlayers()) do
                    if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("Head") and plr.Character:FindFirstChild("Humanoid") and plr.Character.Humanoid.Health > 0 then
                        local isSelectedTarget = Toggles.ESPTarget and plr.Name == Values.SelectedTargetName

                        if Toggles.ESP or isSelectedTarget then
                            local hl = Instance.new("Highlight")
                            hl.Adornee = plr.Character
                            hl.FillColor = Color3.fromRGB(0, 255, 120)
                            hl.FillTransparency = 0.5
                            hl.Parent = ESPWorldFolder
                        end

                        if Toggles.Tracers and camera and viewport then
                            local screenPos, onScreen = camera:WorldToViewportPoint(plr.Character.Head.Position)
                            if onScreen and screenPos.Z > 0 then
                                local startPos = Vector2.new(viewport.X / 2, viewport.Y)
                                local endPos = Vector2.new(screenPos.X, screenPos.Y)
                                local delta = endPos - startPos
                                local line = Instance.new("Frame")
                                line.Name = "Tracer_" .. plr.Name
                                line.AnchorPoint = Vector2.new(0.5, 0.5)
                                line.BorderSizePixel = 0
                                line.BackgroundColor3 = isSelectedTarget and Color3.fromRGB(255, 220, 80) or Color3.fromRGB(0, 255, 120)
                                line.BackgroundTransparency = 0.15
                                line.Position = UDim2.fromOffset((startPos.X + endPos.X) / 2, (startPos.Y + endPos.Y) / 2)
                                line.Size = UDim2.fromOffset(math.max(delta.Magnitude, 2), 2)
                                line.Rotation = math.deg(math.atan2(delta.Y, delta.X))
                                line.ZIndex = 5
                                line.Parent = ESPTracerContainer
                            end
                        end

                        if Toggles.ESPInfo or isSelectedTarget then
                            local head = plr.Character.Head
                            local targetHumanoid = plr.Character:FindFirstChildOfClass("Humanoid")
                            local localRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                            local distance = localRoot and math.floor((localRoot.Position - head.Position).Magnitude) or 0

                            local info = Instance.new("BillboardGui")
                            info.Name = "Info_" .. plr.Name
                            info.Adornee = head
                            info.AlwaysOnTop = true
                            info.Size = UDim2.fromOffset(250, 62)
                            info.StudsOffset = Vector3.new(0, 2.8, 0)
                            info.Parent = ESPBillboardFolder

                            local avatar = Instance.new("ImageLabel")
                            avatar.Name = "AvatarThumbnail"
                            avatar.BackgroundColor3 = Color3.fromRGB(20, 25, 30)
                            avatar.BackgroundTransparency = 0.15
                            avatar.BorderSizePixel = 0
                            avatar.Size = UDim2.fromOffset(48, 48)
                            avatar.Position = UDim2.fromOffset(2, 7)
                            avatar.Image = GetPlayerThumbnail(plr)
                            avatar.Parent = info

                            local avatarCorner = Instance.new("UICorner")
                            avatarCorner.CornerRadius = UDim.new(0, 8)
                            avatarCorner.Parent = avatar

                            local text = Instance.new("TextLabel")
                            text.BackgroundTransparency = 1
                            text.Position = UDim2.fromOffset(56, 2)
                            text.Size = UDim2.new(1, -58, 1, -4)
                            text.Font = Enum.Font.GothamBold
                            text.TextSize = 12
                            text.TextWrapped = true
                            text.TextXAlignment = Enum.TextXAlignment.Left
                            text.TextYAlignment = Enum.TextYAlignment.Center
                            text.TextStrokeTransparency = 0.35
                            text.TextColor3 = isSelectedTarget and Color3.fromRGB(255, 220, 80) or Color3.fromRGB(240, 255, 245)
                            text.Text = string.format(
                                "%s\n@%s | ID: %d\nHP: %d | %dst",
                                plr.DisplayName,
                                plr.Name,
                                plr.UserId,
                                math.floor(targetHumanoid.Health),
                                distance
                            )
                            text.Parent = info
                        end
                    end
                end
            end
        end)

        local SavedAvatarDescription = nil

        local function ApplyAvatarFromInput(username, userIdText)
            local char = LocalPlayer.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if not hum then
                Notify("Karakter belum siap")
                return
            end

            local userId
            local cleanUsername = tostring(username or ""):match("^%s*(.-)%s*$")
            local cleanUserId = tostring(userIdText or ""):match("^%s*(%d+)%s*$")
            if cleanUsername and cleanUsername ~= "" then
                local success, resolvedId = pcall(function()
                    return Services.Players:GetUserIdFromNameAsync(cleanUsername)
                end)
                if success then userId = resolvedId end
            end
            if not userId and cleanUserId then
                userId = tonumber(cleanUserId)
            end

            if not userId then
                Notify("Username atau User ID tidak valid")
                return
            end

            if not SavedAvatarDescription then
                pcall(function()
                    SavedAvatarDescription = hum:GetAppliedDescription()
                end)
            end

            local success, description = pcall(function()
                if Services.Players.GetHumanoidDescriptionFromUserIdAsync then
                    return Services.Players:GetHumanoidDescriptionFromUserIdAsync(userId)
                end
                return Services.Players:GetHumanoidDescriptionFromUserId(userId)
            end)
            if not success or not description then
                Notify("Avatar publik gagal diambil")
                return
            end

            local applied = pcall(function()
                if hum.ApplyDescriptionReset then
                    hum:ApplyDescriptionReset(description)
                else
                    hum:ApplyDescription(description)
                end
            end)
            Notify(applied and "Avatar berhasil diterapkan secara lokal" or "Avatar tidak bisa diterapkan di rig ini")
        end

        AvatarTab:Paragraph({
            Title = "👤 PROFIL SAYA",
            Desc = string.format(
                "%s\n@%s\nUser ID: %d\nUmur akun: %d hari",
                LocalPlayer.DisplayName,
                LocalPlayer.Name,
                LocalPlayer.UserId,
                LocalPlayer.AccountAge
            )
        })

        AvatarTab:Button({
            Title = "🔄 Refresh Info Avatar",
            Callback = function()
                Notify(string.format("@%s | User ID: %d", LocalPlayer.Name, LocalPlayer.UserId))
            end
        })

        AvatarTab:Paragraph({
            Title = "CHANGE AVATAR",
            Desc = "Masukkan username Roblox atau User ID publik. Perubahan hanya terlihat secara lokal."
        })

        AvatarTab:Input({
            Title = "Username Roblox",
            Placeholder = "Contoh: Builderman",
            Callback = function(text)
                Values.AvatarUsername = tostring(text or "")
            end
        })

        AvatarTab:Input({
            Title = "User ID Roblox",
            Placeholder = "Contoh: 156",
            Callback = function(text)
                Values.AvatarUserId = tostring(text or "")
            end
        })

        AvatarTab:Button({
            Title = "🧠 Terapkan Avatar",
            Callback = function()
                ApplyAvatarFromInput(Values.AvatarUsername, Values.AvatarUserId)
            end
        })

        AvatarTab:Button({
            Title = "↩ Restore Avatar Awal",
            Callback = function()
                local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
                if hum and SavedAvatarDescription then
                    local restored = pcall(function()
                        hum:ApplyDescription(SavedAvatarDescription)
                    end)
                    Notify(restored and "Avatar awal dikembalikan" or "Avatar awal gagal dipulihkan")
                else
                    Notify("Avatar awal belum tersimpan")
                end
            end
        })

        ScriptTab:Button({
            Title = "🛑 Panic Reset Semua Fitur",
            Callback = function()
                for key, value in pairs(Toggles) do
                    if type(value) == "boolean" then Toggles[key] = false end
                end
                if Toggles._AntiAFKConnection then
                    Toggles._AntiAFKConnection:Disconnect()
                    Toggles._AntiAFKConnection = nil
                end
                if workspace.CurrentCamera then
                    workspace.CurrentCamera.FieldOfView = 70
                    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid") then
                        workspace.CurrentCamera.CameraSubject = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
                    end
                end
                workspace.Gravity = 196.2
                Notify("Semua fitur di-reset")
            end
        })

        Services.RunService.Heartbeat:Connect(function()
            local char = LocalPlayer.Character
            local hum = char and char:FindFirstChild("Humanoid")
            local hrp = char and char:FindFirstChild("HumanoidRootPart")

            if hum then
                if Toggles.Speed then hum.WalkSpeed = Values.SpeedVal end
                if Toggles.Jump then hum.JumpPower = Values.JumpVal end
            end

            if Toggles.NoClip and char then
                for _, part in pairs(char:GetDescendants()) do
                    if part:IsA("BasePart") then part.CanCollide = false end
                end
            end

            if Toggles.SpinBot and hrp then
                hrp.CFrame = hrp.CFrame * CFrame.Angles(0, math.rad(Values.SpinSpeed), 0)
            end

            if Toggles.Fly and hrp then
                local moveDir = hum and hum.MoveDirection or Vector3.zero
                hrp.Velocity = Vector3.new(moveDir.X * Values.FlySpeed, 0, moveDir.Z * Values.FlySpeed)
            end

            local target = GetTargetPlayer()
            if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") and hrp then
                local tHrp = target.Character.HumanoidRootPart

                if Toggles.LiftTarget then
                    local targetCF = hrp.CFrame * CFrame.new(0, 4, 0)
                    tHrp.CFrame = tHrp.CFrame:Lerp(targetCF, 0.18)
                elseif Toggles.AnnoyTarget then
                    local wobble = math.sin(tick() * 18) * 1.2
                    local targetCF = tHrp.CFrame * CFrame.new(wobble, 0, -2.0) * CFrame.Angles(0, math.rad(180), 0)
                    hrp.CFrame = hrp.CFrame:Lerp(targetCF, 0.18)
                end
            end
        end)

        Notify("NANG Ready")
    end)
end

