    ScanBtn.MouseButton1Click:Connect(function()
        if ActivePage ~= "RBXM" and ActivePage ~= "RBXMX" then
            showPage("RBXM")
        end
        ScanBtn.Text = "↻  SCANNING..."
        clearResults()
        EmptyFrame.Visible = true
        EmptyLabel.Text = "⏳ Mencari file di HP kamu..."
        StatsText.Text = "Status: Scanning..."

        task.spawn(function()
            local scanned = scanAll()
            local found = {}
            for _, f in ipairs(scanned) do
                if ActivePage == "RBXMX" then
                    if f.path:lower():match("%.rbxmx$") then table.insert(found, f) end
                elseif ActivePage == "RBXM" then
                    if f.path:lower():match("%.rbxm$") then table.insert(found, f) end
                else
                    table.insert(found, f)
                end
            end
            for _, f in ipairs(found) do buildFileCard(f) end
            EmptyFrame.Visible = (#found == 0)
            if #found == 0 then
                EmptyLabel.Text = "Tidak ada file "..ActivePage.." ditemukan.\n\nTaruh file di /sdcard/Download lalu scan lagi."
            end
            StatsText.Text = string.format("Status: %d %s file(s)", #found, ActivePage)
            ScanBtn.Text = "↻  SCAN FILES"
            if #found == 0 then
                notify("Scan Selesai", "Tidak ada file ditemukan.", Color3.fromRGB(220,200,150))
            else
                notify("Scan Selesai", #found.." file ditemukan.", Color3.fromRGB(150,200,150))
            end
        end)
    end)

