-- ═══════════════════════════════════════════════════════════════════════
-- REPLAY
-- ═══════════════════════════════════════════════════════════════════════
local replayThreads = {}
local REPLAY_INTERVAL = 0.15   -- jeda antar replay, adjust kalau terlalu cepat/lambat

local function startReplay()
    if replayOn then return end
    replayOn = true
    ReplayBtn.Text = "REPLAY: ON"
    ReplayBtn.BackgroundColor3 = Color3.fromRGB(40, 140, 40)

    for _, c in ipairs(captured) do
        if c.args then
            local thread = task.spawn(function()
                while replayOn do
                    local ok, err = pcall(function()
                        -- reconstruct args
                        local remote = nil
                        -- find remote by path
                        local success, found = pcall(function()
                            local parts = {}
                            for part in string.gmatch(c.path, "[^%.]+") do
                                table.insert(parts, part)
                            end
                            -- parts biasanya: ReplicatedStorage, ..., RemoteName
                            local node = game
                            for i = 2, #parts do
                                local child = node:FindFirstChild(parts[i])
                                if not child then return nil end
                                node = child
                            end
                            return node
                        end)
                        if success and found and typeof(found) == "Instance"
                        and (found:IsA("RemoteEvent") or found:IsA("RemoteFunction")) then
                            remote = found
                        end

                        if remote then
                            if c.method == "FireServer" and remote:IsA("RemoteEvent") then
                                remote:FireServer(unpack(c.args, 1, c.argc))
                            elseif c.method == "InvokeServer" and remote:IsA("RemoteFunction") then
                                task.spawn(function() remote:InvokeServer(unpack(c.args, 1, c.argc)) end)
                            end
                        end
                    end)
                    task.wait(REPLAY_INTERVAL)
                end
            end)
            table.insert(replayThreads, thread)
        end
    end
end

local function stopReplay()
    replayOn = false
    ReplayBtn.Text = "REPLAY ON"
    ReplayBtn.BackgroundColor3 = Color3.fromRGB(60, 100, 60)
    replayThreads = {}
end

ReplayBtn.MouseButton1Click:Connect(startReplay)
StopBtn.MouseButton1Click:Connect(stopReplay)

ResetBtn.MouseButton1Click:Connect(function()
