-- METODE G: Frame animation from GIF
-- Convert mp4 to GIF via public API, parse GIF client-side, cycle frames
local function methodG_gif_frames(info, parent)
    -- tikwm might return an animated cover for some posts
    -- otherwise use external GIF conversion

    -- try to get GIF URL from tikwm
    local gifUrl = info and (info.animated_cover or info.ai_dynamic_cover or info.cover_gif)
    if not gifUrl and info and info.id then
        -- try constructing tiktok GIF URL patterns
        local patterns = {
            "https://p16-sign-va.tiktokcdn.com/tos-maliva-p-0068/" .. tostring(info.id) .. "~tplv-tiktokx-origin.image",
            "https://p16-sign-va.tiktokcdn.com/obj/tos-maliva-p-0068/" .. tostring(info.id) .. "?a=1988",
        }
        for _, p in ipairs(patterns) do
            gifUrl = p
            break
        end
    end

    if not gifUrl then return "NO GIF SOURCE" end

    -- render as rapid-cycling ImageLabel (if animated webp/gif somehow renders)
    local img = Instance.new("ImageLabel")
    img.Size = UDim2.new(0,120,0,180); img.Position = UDim2.new(0,0,0,0)
    img.BackgroundColor3 = Color3.fromRGB(20,20,30); img.BorderSizePixel = 0
    img.Image = gifUrl
    img.ScaleType = Enum.ScaleType.Crop
    img.Parent = parent
    task.wait(1.2)
    local loaded = false
    pcall(function() loaded = img.IsLoaded end)
    return loaded and "IMAGE LOADED" or "IMAGE LOAD FAIL (or no anim support)"
end

