                TweenService:Create(o, fade, {TextTransparency = 1}):Play()
            elseif o:IsA("Frame") then
                TweenService:Create(o, fade, {BackgroundTransparency = 1}):Play()
            elseif o:IsA("ImageLabel") then
                TweenService:Create(o, fade, {ImageTransparency = 1}):Play()
            elseif o:IsA("UIStroke") then
                TweenService:Create(o, fade, {Transparency = 1}):Play()
            end
        end
        TweenService:Create(LoadCard, fade, {BackgroundTransparency = 1}):Play()
        task.wait(0.35)
        if LoadUI.Parent then LoadUI:Destroy() end
    end
    task.spawn(function()
        for _, step in ipairs(loadSteps) do
            if skipLoad or not LoadUI.Parent then finishLoad(); return end
            LoadStatus.Text = step[2]
            local startP = Progress.Size.X.Scale
            local t0 = tick()
            local dur = 0.4
            while tick()-t0 < dur do
                if skipLoad then finishLoad(); return end
                local a = math.clamp((tick()-t0)/dur, 0, 1)
                local p = startP + (step[1]-startP)*a
                Progress.Size = UDim2.new(p, 0, 1, 0)
                PercentL.Text = string.format("%d%%", math.floor(p*100))
                task.wait(0.02)
            end
            Progress.Size = UDim2.new(step[1], 0, 1, 0)
            PercentL.Text = string.format("%d%%", math.floor(step[1]*100))
        end
        task.wait(0.35)
        finishLoad()
    end)

