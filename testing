    fireBtn.MouseButton1Click:Connect(function()
        local ok, err = pcall(function()
            if remote:IsA("RemoteEvent") then
                remote:FireServer()
            else
                remote:InvokeServer()
            end
        end)
        clickCount = clickCount + 1
        countLbl.Text = tostring(clickCount)
        if ok then
            status.BackgroundColor3 = Color3.fromRGB(80, 200, 80)
            fireBtn.BackgroundColor3 = Color3.fromRGB(80, 160, 80)
            task.delay(0.3, function()
                if fireBtn.Parent then
                    fireBtn.BackgroundColor3 = Color3.fromRGB(40, 90, 40)
                end
            end)
        else
            status.BackgroundColor3 = Color3.fromRGB(200, 80, 80)
            fireBtn.BackgroundColor3 = Color3.fromRGB(140, 40, 40)
            warn("[scanner] " .. remote.Name .. " err: " .. tostring(err))
        end
    end)

    -- long press / right click = fire with extra args
    return row
end

-- ═══════════════════════════════════════════════════════════════════════
-- SCAN
-- ═══════════════════════════════════════════════════════════════════════
local function clearList()
    for _, c in ipairs(List:GetChildren()) do
        if c:IsA("Frame") then c:Destroy() end
    end
    rowIndex = 0
    remotes = {}
end

local function scanNow()
    clearList()
    local function walk(parent)
        for _, obj in ipairs(parent:GetDescendants()) do
            if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
                table.insert(remotes, obj)
            end
        end
    end
    walk(RS)
    walk(workspace)
    pcall(function() walk(game:GetService("ReplicatedFirst")) end)
    pcall(function() walk(game:GetService("Players")) end)

    -- sort by path
    table.sort(remotes, function(a, b)
        return (a.Parent and a.Parent:GetFullName() or "") < (b.Parent and b.Parent:GetFullName() or "")
    end)

    for _, r in ipairs(remotes) do buildRow(r) end
    updateCount()
    print(string.format("[scanner] %d remotes", #remotes))
end

ScanBtn.MouseButton1Click:Connect(scanNow)
ClearBtn.MouseButton1Click:Connect(function()
    clearList()
    updateCount()
end)

-- ═══════════════════════════════════════════════════════════════════════
-- FILTER
-- ═══════════════════════════════════════════════════════════════════════
Search:GetPropertyChangedSignal("Text"):Connect(function()
    local q = Search.Text:lower()
    for _, c in ipairs(List:GetChildren()) do
        if c:IsA("Frame") then
            if q == "" then
                c.Visible = true
            else
                local n = ""
                local nl = c:FindFirstChildOfClass("TextLabel")
                if nl then n = nl.Text:lower() end
                c.Visible = n:find(q, 1, true) ~= nil
            end
        end
    end
    updateCount()
end)

