-- METODE I: Direct internal video service call (probe)
local function methodI_internal_probe()
    local services = {
        "VideoCaptureService",
        "VideoService",
        "VideoFrameService",
    }
    local found = {}
    for _, name in ipairs(services) do
        local ok, s = pcall(function() return game:GetService(name) end)
        if ok and s then table.insert(found, name) end
    end
    if #found == 0 then return "NO INTERNAL VIDEO SVC" end
    return "FOUND: " .. table.concat(found, ", ")
end

-- METODE J: getobjects / InsertService with local file
local function methodJ_getobjects(mp4path)
    local caps = probe()
    local asset = toCustomAsset(mp4path)
    if not asset then return "NO GETCUSTOMASSET" end
    local ok, objs = pcall(function() return game:GetObjects(asset) end)
    if not ok then return "GETOBJECTS ERR" end
    if type(objs) ~= "table" then return "NOT TABLE" end
