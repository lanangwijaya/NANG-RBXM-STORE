        if Remotes then
            local StatusUpdateEvent = Remotes:FindFirstChild("StatusUpdateEvent")
            local TimeUpdateEvent = Remotes:FindFirstChild("TimeUpdateEvent")
            if StatusUpdateEvent then StatusUpdateEvent.OnClientEvent:Connect(function(arg2) end) end
            if TimeUpdateEvent then TimeUpdateEvent.OnClientEvent:Connect(function(arg3) end) end
        end
    end)

