        SearchHead.Visible=true; SearchScroll.Visible=true; Right.Visible=true; ScanBtn.Visible=true
        SearchHead.Text="  FILE IMPORT  •  "..page
        Format.Text="SUPPORTED\n\n✓ RBXM\n✓ RBXMX\n\nTekan SCAN FILES."
    elseif page=="EXECUTE" then
        showExecutePanel()
    elseif page=="SETTINGS" then
        showSettingsPanel()
    elseif page=="VIP" or page=="COMBAT" or page=="VISUAL" or page=="MOVEMENT" or page=="WORLD" or page=="FARM" or page=="TARGET" or page=="QUICK" or page=="SERVER" then
        showVipPanel(page)
    elseif page=="CREDITS" then
        showCreditsPanel()
    end
end

