    local function finishLoad()
        local fade = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        TweenService:Create(LoadUI, fade, {BackgroundTransparency = 1}):Play()
        for _, o in ipairs(LoadCard:GetDescendants()) do
