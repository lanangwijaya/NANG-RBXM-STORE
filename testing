local minimized = false

mini.MouseButton1Click:Connect(function()

    minimized = not minimized

    if minimized then

        for _, obj in ipairs(main:GetChildren()) do
            if obj ~= header and obj ~= corner then
                obj.Visible = false
            end
        end

        main.Size = UDim2.fromOffset(240,45)
        mini.Text = "+"
        
    else

        main.Size = UDim2.fromOffset(240,180)

        for _, obj in ipairs(main:GetChildren()) do
            if obj ~= header and obj ~= corner then
                obj.Visible = true
            end
        end

        mini.Text = "—"

    end
end)

