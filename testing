local function equipRod(name)
    for _, r in ipairs(rodRemotes) do
        pcall(function()
            if r:IsA("RemoteEvent") then
                r:FireServer(name)
            else
                task.spawn(function() r:InvokeServer(name) end)
            end
        end)
    end
end

