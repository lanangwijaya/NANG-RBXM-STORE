local function setVIPState(name,state)
    VIPState[name]=state
    if name=="Speed" then
        if not state and LocalPlayer.Character then
            local h=LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
            if h then h.WalkSpeed=16 end
        end
    elseif name=="Jump" then
        if not state and LocalPlayer.Character then
            local h=LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
            if h then h.JumpPower=50 end
        end
    elseif name=="Fullbright" then
        if state then
            Lighting.Ambient=Color3.fromRGB(255,255,255)
            Lighting.Brightness=2
        else
            Lighting.Ambient=Color3.fromRGB(128,128,128)
            Lighting.Brightness=1
        end
    elseif name=="FPSBooster" and state then
        Lighting.GlobalShadows=false
    elseif name=="InfJump" then
        if VIPConnections.InfJump then VIPConnections.InfJump:Disconnect(); VIPConnections.InfJump=nil end
        if state then
