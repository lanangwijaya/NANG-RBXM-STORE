--========================================================
-- SCAN WORKSPACE
--========================================================

local function scan()
    local count = 0

    pcall(function()
        for _,obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("BasePart") then
                count += 1
            end
        end
    end)

    return count
end

local function anchorAll()
    local count = 0

    pcall(function()
        for _,obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("BasePart") then
                pcall(function()
                    obj.Anchored = true
                    count += 1
                end)
            end
        end
    end)

    return count
end

local function unanchorAll()
    local count = 0

    pcall(function()
        for _,obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("BasePart") then
                pcall(function()
                    obj.Anchored = false
                    count += 1
                end)
            end
        end
    end)

    return count
end

