    local function Buffer(str, allowOverflows)
        local S = {Offset=0, Source=str, Length=#str}
        function S:read(len, shift)
            len = len or 1; shift = (shift == nil) and true or shift
            local d = string.sub(self.Source, self.Offset+1, self.Offset+len)
            if shift then self:seek(len) end
            return d
        end
        function S:seek(n) self.Offset = math.clamp(self.Offset+n, 0, self.Length) end
        function S:readNumber(fmt) fmt = fmt or "I1"; return string.unpack(fmt, self:read(string.packsize(fmt))) end
        function S:append(s) self.Source = self.Source..s; self.Length = #self.Source end
        function S:toEnd() self.Offset = self.Length end
        return S
    end
    local function tInt(x) return (x%2==0) and (x/2) or (-(x+1)/2) end
    local function rbxF32(x) x = bit32.rrotate(x,1); return string.unpack(">f", string.pack(">I4", x)) end

    local BT = {}
    BT.String = function(b) return b:read(b:readNumber("<I4")) end
    BT.Int32 = function(b) return tInt(b:readNumber(">I4")) end
    BT.Int64 = function(b) return tInt(b:readNumber(">I8")) end
    BT.F32 = function(b) return rbxF32(b:readNumber(">I4")) end
    BT.F64 = function(b) return b:readNumber("<d") end

    BT.interleave = function(buf, count, size)
        if count < 0 then return Buffer("", false) end
        local stream = buf:read(count*size); local out = table.create(count)
        for i=1,count do
            local c = table.create(size)
            for s=0,size-1 do local p = i+(count*s); c[s+1] = string.sub(stream,p,p) end
            out[i] = table.concat(c)
        end
        return Buffer(table.concat(out), false)
    end
    BT.uintArr = function(buf, count)
        if count<1 then return {} end
        local o = table.create(count); local s = BT.interleave(buf, count, 4)
        for i=1,count do o[i] = s:readNumber("<I4") end
        return o
    end
    BT.int32Arr = function(buf, count)
        if count<1 then return {} end
        local o = table.create(count); local s = BT.interleave(buf, count, 4)
        for i=1,count do o[i] = BT.Int32(s) end
        return o
    end
    BT.f32Arr = function(buf, count)
        if count<1 then return {} end
        local o = table.create(count); local s = BT.interleave(buf, count, 4)
        for i=1,count do o[i] = BT.F32(s) end
        return o
    end
    BT.refArr = function(buf, count)
        if count<1 then return {} end
        local o = table.create(count); local refs = BT.int32Arr(buf, count); local last = 0
        for i=1,count do local r = last+refs[i]; o[i] = r; last = r end
        return o
    end

    local function lz4(data)
        local inp = Buffer(data)
        local compressedLen = string.unpack("<I4", inp:read(4))
        local decompressedLen = string.unpack("<I4", inp:read(4))
        local reserved = string.unpack("<I4", inp:read(4))
        if reserved ~= 0 then error("not lz4") end
        if compressedLen == 0 then return inp:read(decompressedLen) end
        local out = Buffer("")
        repeat
            local token = string.byte(inp:read())
            local litLen = bit32.rshift(token, 4)
            local matLen = bit32.band(token, 15) + 4
            if litLen >= 15 then
                repeat local nb = string.byte(inp:read()); litLen = litLen+nb until nb ~= 0xFF
            end
            local lit = inp:read(litLen); out:append(lit); out:toEnd()
            if out.Length < decompressedLen then
                local offset = string.unpack("<I2", inp:read(2))
                if matLen >= 19 then
                    repeat local nb = string.byte(inp:read()); matLen = matLen+nb until nb ~= 0xFF
                end
                out:seek(-offset)
                local pos = out.Offset; local m = out:read(matLen)
                local urb = out.LastUnreadBytes or 0
                if urb then
                    repeat
                        out.Offset = pos; local extra = out:read(urb)
                        urb = out.LastUnreadBytes or 0; m = m..extra
                    until urb <= 0
                end
                out:append(m); out:toEnd()
            end
        until out.Length >= decompressedLen
        return out.Source
    end

    local function b64(str)
        local chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
        local o = {}
        for i=1,#str,3 do
            local b0,b1,b2 = string.byte(str,i,i+2)
            local b = bit32.lshift(b0,16) + bit32.lshift(b1 or 0,8) + (b2 or 0)
            table.insert(o, chars:sub(bit32.extract(b,18,6)+1, bit32.extract(b,18,6)+1))
            table.insert(o, chars:sub(bit32.extract(b,12,6)+1, bit32.extract(b,12,6)+1))
            table.insert(o, b1 and chars:sub(bit32.extract(b,6,6)+1, bit32.extract(b,6,6)+1) or "=")
            table.insert(o, b2 and chars:sub(bit32.band(b,63)+1, bit32.band(b,63)+1) or "=")
        end
        return table.concat(o)
    end
    local function zstd(stream)
        local z = b64(stream)
        local j = '{"m":null,"t":"buffer","zbase64":"'..z..'"}'
        local x = HttpService:JSONDecode(j)
        return buffer.tostring(x)
    end

    local function parseRBXM(data)
        local sources = {}
        local buf = Buffer(data, false)
        if buf:read(8) ~= "<roblox!" then return sources end
        buf:read(6)
        buf:read(2)
        buf:readNumber("<i4")
        buf:readNumber("<i4")
        local classRefs, vInst, strings, chunks = {}, {}, {}, {}
        local ENDC = "END"..string.char(0)
        local valid = {[ENDC]=true, ["INST"]=true, ["META"]=true, ["PRNT"]=true, ["PROP"]=true, ["SIGN"]=true, ["SSTR"]=true}
        for k in pairs(valid) do chunks[k] = {} end
        buf:read(8)
        local idx, last = 0, nil
        repeat
            idx = idx + 1
            local ch = {Header = buf:read(4)}
            if not valid[ch.Header] then break end
            local lz4h = buf:read(16, false)
            local comp = string.unpack("<I4", string.sub(lz4h,1,4))
            local decomp = string.unpack("<I4", string.sub(lz4h,5,8))
            local zchk = string.sub(lz4h,13,16)
            local dc
            if comp == 0 then dc = buf:read(decomp+12)
            else
                if zchk == "\x28\xB5\x2F\xFD" then buf:seek(12); dc = zstd(buf:read(comp))
                else dc = lz4(buf:read(comp+12)) end
            end
            ch.Data = Buffer(dc, false); table.insert(chunks[ch.Header], ch); last = ch
        until last and last.Header == ENDC

        for _, ch in ipairs(chunks["SSTR"] or {}) do
            local b = ch.Data
            if b:readNumber("<I4") == 0 then
                for i=1,b:readNumber("<I4") do b:read(16); strings[i] = BT.String(b) end
            end
        end
        for _, ch in ipairs(chunks["INST"] or {}) do
            local b = ch.Data
            local cid = b:readNumber("<I4"); local cname = BT.String(b)
            if b:read() == "\1" then return sources end
            local cnt = b:readNumber("<I4"); local refs = BT.refArr(b, cnt)
            classRefs[cid] = {Name=cname, Sizeof=cnt, Refs=refs}
            for _, r in ipairs(refs) do vInst[r] = {ClassId=cid, ClassName=cname, Ref=r, Properties={}, Children={}} end
        end
        for _, ch in ipairs(chunks["PROP"] or {}) do
            local b = ch.Data
            local cid = b:readNumber("<I4"); local cr = classRefs[cid]
            if not cr then break end
            local refs = cr.Refs; local sz = cr.Sizeof; local nm = BT.String(b)
            if string.byte(b:read(1, false)) == 0x1E then b:seek(1) end
            local tid = string.byte(b:read()); local props = {}
            if tid == 0x01 or tid == 0x1D then
                for i=1,sz do props[i] = BT.String(b) end
            elseif tid == 0x02 then
                for i=1,sz do props[i] = b:read() ~= string.char(0) end
            elseif tid == 0x03 then props = BT.int32Arr(b, sz)
            elseif tid == 0x04 then props = BT.f32Arr(b, sz)
            elseif tid == 0x05 then for i=1,sz do props[i] = BT.F64(b) end
            else
                for i=1,sz do
                    if tid == 0x13 then props = BT.refArr(b, sz); break else b:read(4) end
                end
            end
            if nm == "Source" or nm == "ContentText" then
                for i,v in ipairs(refs) do
                    if vInst[v] and props[i] then vInst[v].Properties[nm] = props[i] end
                end
            end
        end
        local function addAlias(key, src)
            if not key or key=="" or not src or #src==0 then return end
            local k = "__A__"..key
            if type(sources[k]) ~= "table" then sources[k] = {} end
            table.insert(sources[k], src)
        end
        local function build(node, path)
            local src = node.Properties["Source"] or node.Properties["ContentText"]
            if src and type(src)=="string" and #src>0 then
                src = src:gsub(string.char(0).."*$", "")
                sources[path] = src
                local cn = tostring(node.ClassName or "")
                local nm = tostring(node.Properties["Name"] or "")
                if cn ~= "" and nm ~= "" then addAlias(cn..":"..nm, src) end
                if nm ~= "" then addAlias(nm, src) end
            end
            for _, c in ipairs(node.Children or {}) do
                build(c, path.."."..c.ClassName..":"..(c.Properties["Name"] or "u"))
            end
        end
        for _, ch in ipairs(chunks["PRNT"] or {}) do
            local b = ch.Data
            if b:read() ~= string.char(0) then break end
            local cnt = b:readNumber("<I4")
            local crefs = BT.refArr(b, cnt); local prefs = BT.refArr(b, cnt)
            for i=1,cnt do
                local c = vInst[crefs[i]]; local p = vInst[prefs[i]]
                if c and p then table.insert(p.Children, c) end
            end
        end
        local roots = {}
        for _, inst in pairs(vInst) do
            local has = false
            for _, o in pairs(vInst) do
                for _, c in ipairs(o.Children or {}) do if c.Ref == inst.Ref then has=true; break end end
                if has then break end
            end
            if not has then table.insert(roots, inst) end
        end
        for _, r in ipairs(roots) do build(r, r.ClassName..":"..(r.Properties["Name"] or "root")) end
        return sources
    end

