    -- CREATOR STORE SEARCH — 5 PAGES (~150 hasil)
    -- ═══════════════════════════════════════════════════════════════════
    local APIS = {
        MODEL = {"https://apis.roblox.com/toolbox-service/v1/marketplace/10",
                 "https://apis.roproxy.com/toolbox-service/v1/marketplace/10"},
        DECAL = {"https://apis.roblox.com/toolbox-service/v1/marketplace/13",
                 "https://apis.roproxy.com/toolbox-service/v1/marketplace/13"},
        AUDIO = {"https://apis.roblox.com/toolbox-service/v1/marketplace/3",
                 "https://apis.roproxy.com/toolbox-service/v1/marketplace/3"},
    }
    local PAGES = 5

    local function searchCreator(kw, kind)
        kw = tostring(kw or ""):gsub("^%s+",""):gsub("%s+$","")
        if kw == "" then return false, "Kata kunci kosong" end
        kind = tostring(kind or "MODEL"):upper()
        if not APIS[kind] then kind = "MODEL" end

        local results, seen = {}, {}
        local lastErr = "Tidak ada respons"

        for page = 0, PAGES-1 do
            local q = "?limit=30&pageNumber="..page.."&keyword="..HttpService:UrlEncode(kw).."&includeOnlyVerifiedCreators=false"
            local pageData = nil
            for _, base in ipairs(APIS[kind]) do
                local body = httpRequest(base..q)
                if body then
                    local ok, data = pcall(function() return HttpService:JSONDecode(body) end)
                    if ok and type(data)=="table" then
                        local raw = data.data or data.items or data.results
                        if type(raw)=="table" then pageData = raw; break
                        else lastErr = "Respons tidak berisi daftar" end
                    else lastErr = "JSON invalid" end
                end
            end
            if not pageData or #pageData == 0 then break end
            for _, item in ipairs(pageData) do
                local id = tonumber(item.id or item.assetId or item.AssetId or (item.asset and item.asset.id))
                if id and not seen[id] then
                    seen[id] = true
                    local cr = item.creatorName or item.CreatorName or item.creator or "Creator Store"
                    if type(cr)=="table" then cr = cr.name or cr.Name or cr.username or "Creator" end
                    table.insert(results, {
                        id = id,
                        name = tostring(item.name or item.Name or item.title or ("Asset "..id)),
                        creator = tostring(cr),
                        kind = kind
                    })
                end
            end
        end
        if #results == 0 then return false, lastErr end
        return true, results
    end

