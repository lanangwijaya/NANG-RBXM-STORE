    local function extractId(v)
        return tonumber(tostring(v or ""):match("(%d+)"))
    end
    local function insertModel(value)
        local id = extractId(value)
        if not id then return false, "Asset ID tidak valid" end
        local ins
        local ok, r = pcall(function() return InsertService:LoadAsset(id) end)
        if ok and r then ins = r end
        if not ins and game.GetObjects then
            local ok2, r2 = pcall(function() return game:GetObjects("rbxassetid://"..id) end)
            if ok2 and r2 and #r2 > 0 then
                ins = Instance.new("Folder"); ins.Name = "Toolbox_"..id; ins.Parent = workspace
                for _, o in ipairs(r2) do o.Parent = ins end
            end
        end
        if not ins then return false, "Model gagal dimuat (mungkin private/locked)" end
        if ins.Parent == nil then ins.Parent = workspace end

        local caps = captureSrc(ins)
        local inj = injectAll(ins, {})
        applyProps(ins)
        loadAssetsSL(ins)
        return true, ins.Name.." (script "..inj..", source "..caps..")"
    end
    local function getMusicFolder()
        local f = workspace:FindFirstChild("NANG_MUSIC")
        if not f then f = Instance.new("Folder"); f.Name = "NANG_MUSIC"; f.Parent = workspace end
        return f
    end
    local function insertAudio(value, name)
        local id = extractId(value)
        if not id then return false, "Audio ID tidak valid" end
        local folder = getMusicFolder()
        local finalName = tostring(name or ("Music_"..id))
        local ok, r = pcall(function() return InsertService:LoadAsset(id) end)
        if ok and r then
            local s = r:IsA("Sound") and r or r:FindFirstChildWhichIsA("Sound", true)
            if s then
                s.Name = finalName
                s.Parent = folder
                if r ~= s then pcall(function() r:Destroy() end) end
                return true, s.Name.." → Workspace.NANG_MUSIC"
            end
            pcall(function() r:Destroy() end)
        end
        local s = Instance.new("Sound")
        s.Name = finalName
        s.SoundId = "rbxassetid://"..id
        s.Volume = 0.5
        s.Parent = folder
        return true, s.Name.." → Workspace.NANG_MUSIC"
    end
    local function insertAsset(value, kind, name)
        kind = tostring(kind or "MODEL"):upper()
        if kind == "AUDIO" then return insertAudio(value, name) end
        return insertModel(value)
    end

