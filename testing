--==================================================
-- ANCHOR FUNCTION
--==================================================

local function anchorAll()
    local count = 0

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            pcall(function()
                obj.Anchored = true
                count += 1
            end)
        end
    end

    return count
end

--==================================================
-- UNANCHOR FUNCTION
--==================================================

local function unanchorAll()
    local count = 0

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            pcall(function()
                obj.Anchored = false
                count += 1
            end)
        end
    end

    return count
end

