    local Section2 = Page:CreateSection("Player Features")

    local antiAfkConn
    local AntiAfkToggle = Section2:AddToggle("Anti AFK", false, function(state)
        if state then
            if not antiAfkConn then
                antiAfkConn = LocalPlayer.Idled:Connect(function()
                    pcall(function()
                        VirtualUser:CaptureController()
                        VirtualUser:ClickButton2(Vector2.new())
                    end)
                end)
            end
        else
            if antiAfkConn then antiAfkConn:Disconnect(); antiAfkConn = nil end
        end
    end)
    AntiAfkToggle:AddKeyPicker()

    local noclipConn
    local noclipOn = false
    local NoClipToggle = Section2:AddToggle("NoClip", false, function(state)
        noclipOn = state
        if state and not noclipConn then
            noclipConn = RunService.Stepped:Connect(function()
                if noclipOn and LocalPlayer.Character then
                    for _, p in ipairs(LocalPlayer.Character:GetDescendants()) do
                        if p:IsA("BasePart") and p.CanCollide then
                            pcall(function() p.CanCollide = false end)
                        end
                    end
                end
            end)
        elseif not state and noclipConn then
            noclipConn:Disconnect(); noclipConn = nil
        end
    end)
    NoClipToggle:AddKeyPicker()

    local invisConn
    local invisOn = false
    local function applyInvisible(on)
        local char = LocalPlayer.Character
        if not char then return end
        for _, p in ipairs(char:GetDescendants()) do
            pcall(function()
                if p:IsA("BasePart") then
                    p.LocalTransparencyModifier = on and 1 or 0
                elseif p:IsA("Decal") then
                    p.Transparency = on and 1 or 0
                end
            end)
        end
    end
    local InvisToggle = Section2:AddToggle("Invisible", false, function(state)
        invisOn = state
        applyInvisible(state)
        if state and not invisConn then
            invisConn = RunService.RenderStepped:Connect(function()
                if invisOn then applyInvisible(true) end
            end)
        elseif not state and invisConn then
            invisConn:Disconnect(); invisConn = nil
            applyInvisible(false)
        end
    end)
    InvisToggle:AddKeyPicker()

    local autoExecConn
    local AutoExecToggle = Section2:AddToggle("Auto Execute", false, function(state)
        _G.NANG_AUTO_EXEC = state
        if state and not autoExecConn then
            autoExecConn = LocalPlayer.CharacterAdded:Connect(function()
                if _G.NANG_AUTO_EXEC then
                    task.wait(1)
                    nangSafe("Auto Execute", launchNangFarm)
                end
            end)
        elseif not state and autoExecConn then
            autoExecConn:Disconnect(); autoExecConn = nil
        end
    end)
