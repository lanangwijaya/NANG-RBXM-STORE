-- ═══════════════════════════════════════════════════════════════════════
-- DEEP COPY untuk capture (biar table args nggak berubah)
-- ═══════════════════════════════════════════════════════════════════════
local function deepCopy(v, seen)
    seen = seen or {}
    if type(v) ~= "table" then return v end
    if seen[v] then return seen[v] end
    local c = {}
    seen[v] = c
    for k, vv in pairs(v) do c[deepCopy(k, seen)] = deepCopy(vv, seen) end
    return c
end

-- ═══════════════════════════════════════════════════════════════════════
-- CAPTURE — rekam semua remote call
-- ═══════════════════════════════════════════════════════════════════════
local captured = {}       -- {name, className, args, path, hits}
local captureOn = true
local replayOn  = false

local function logArg(v)
    local t = type(v)
    if t == "string" then return string.format("%q", v) end
    if t == "number" or t == "boolean" or t == "nil" then return tostring(v) end
    if t == "Instance" then return "<" .. v.ClassName .. ":" .. v.Name .. ">" end
    if t == "Vector3" then return string.format("V3(%.1f,%.1f,%.1f)", v.X, v.Y, v.Z) end
    if t == "Vector2" then return string.format("V2(%.1f,%.1f)", v.X, v.Y) end
    if t == "CFrame" then return "CFrame" end
    if t == "table" then
        local parts = {}
        local n = 0
        for k, vv in pairs(v) do
            n = n + 1
            if n > 6 then parts[#parts+1] = "..."; break end
            parts[#parts+1] = tostring(k) .. "=" .. logArg(vv)
        end
        return "{" .. table.concat(parts, ",") .. "}"
    end
    return "<" .. t .. ">"
end

if not getrawmetatable or not setreadonly then
    warn("[CAP] executor nggak support metatable hook — capture impossible")
    return
end

local mt = getrawmetatable(game)
local oldNC = mt.__namecall
setreadonly(mt, false)
mt.__namecall = newcclosure(function(self, ...)
    local method = getnamecallmethod()
    if (method == "FireServer" or method == "InvokeServer")
    and typeof(self) == "Instance"
    and (self:IsA("RemoteEvent") or self:IsA("RemoteFunction")) then
        if captureOn then
            local args = {...}
            local argc = select("#", ...)
            local key = self.Name .. "|" .. method

            -- cari existing capture untuk remote ini
            local found = nil
            for _, c in ipairs(captured) do
                if c.key == key then found = c; break end
            end

            if not found then
                found = {
                    key = key,
                    name = self.Name,
                    className = self.ClassName,
                    method = method,
                    path = (pcall(function() return self:GetFullName() end) and self:GetFullName()) or "?",
                    samples = {},
                    args = nil,        -- last args
                    argc = argc,
                    hits = 0,
                    timestamp = os.clock(),
                }
                table.insert(captured, found)
            end

            found.hits = found.hits + 1
            found.timestamp = os.clock()

            -- deep copy args buat replay
            local copied = {}
            for i = 1, argc do copied[i] = deepCopy(args[i]) end
            found.args = copied
            found.argc = argc

            -- print pertama kali + kalau args berubah
            local argStr = ""
            for i = 1, argc do argStr = argStr .. logArg(copied[i]) .. (i < argc and ", " or "") end
            if found.hits == 1 or found._lastArgStr ~= argStr then
                found._lastArgStr = argStr
                print(string.format("[CAP] %s:%s(%s)", self.Name, method, argStr))
            end
        end
    end
    return oldNC(self, ...)
end)
setreadonly(mt, true)

