-- REMOTE SCAN + FIRE
-- scan semua RemoteEvent, terus fire satu-satu (no args)
-- ═══════════════════════════════════════════════════════════════════════
local RS = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local LP = Players.LocalPlayer

-- ── 1. SCAN ───────────────────────────────────────────────────────────
local remotes = {}
local function scan(parent)
    for _, obj in ipairs(parent:GetDescendants()) do
        if obj:IsA("RemoteEvent") then
            table.insert(remotes, obj)
        end
    end
end

scan(RS)
scan(workspace)
scan(game:GetService("ReplicatedFirst"))

print("\n=== SCAN ===")
print("total RemoteEvent: " .. #remotes)

-- group by parent path
local byPath = {}
for _, r in ipairs(remotes) do
    local p = r.Parent and r.Parent:GetFullName() or "?"
    byPath[p] = byPath[p] or {}
    table.insert(byPath[p], r.Name)
end

for path, names in pairs(byPath) do
    print("\n[" .. path .. "]")
    for _, n in ipairs(names) do
        print("  - " .. n)
    end
end

-- ── 2. FIRE SEMUA ─────────────────────────────────────────────────────
print("\n=== FIRING (no args) ===")
task.wait(1)

for i, r in ipairs(remotes) do
    local ok, err = pcall(function() r:FireServer() end)
    print(string.format("[%d/%d] %s  ->  %s",
        i, #remotes, r.Name,
        ok and "fired" or ("ERR: " .. tostring(err):sub(1, 40))
    ))
    task.wait(0.15)
end

print("\n=== selesai. cek apa yang berubah di game ===")

