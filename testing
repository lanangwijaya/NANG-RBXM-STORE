-- 5. FISH FORCE — coba semua kombinasi argumen
-- ═══════════════════════════════════════════════════════════════════════
local FISH_NAMES = {
    "Divine Fish", "God Fish", "Mythical Fish", "Mythic Fish",
    "Legendary Fish", "Secret Fish", "Golden Fish", "Rainbow Fish",
    "Divine", "God", "Mythical", "Legendary",
    "Salmon", "Tuna", "Swordfish", "Shark", "Whale",
    "divine", "god", "mythical",
    "Divine_Fish", "God_Fish",
}

local function forceFish()
    -- 1. fire dengan nama ikan + angka besar
    for _, fishRemotes_ in ipairs(fishRemotes) do
        for _, fname in ipairs(FISH_NAMES) do
            pcall(function()
                if fishRemotes_:IsA("RemoteEvent") then
                    fishRemotes_:FireServer(fname)
                    fishRemotes_:FireServer(fname, 1)
                    fishRemotes_:FireServer(fname, 9999)
                    fishRemotes_:FireServer(fname, 999999)
                end
            end)
            task.wait(0.02)
        end
        -- 2. fire tanpa argumen
        pcall(function()
            if fishRemotes_:IsA("RemoteEvent") then
                fishRemotes_:FireServer()
            end
        end)
        -- 3. fire dengan table
        pcall(function()
            if fishRemotes_:IsA("RemoteEvent") then
                fishRemotes_:FireServer({name = "Divine Fish", weight = 99999, value = 999999})
            end
        end)
    end
end

