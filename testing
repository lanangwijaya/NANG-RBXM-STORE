        if not winner and rG:find("LOADED") then winner = {src = "G", method = rG, url = info.cover} end
        task.wait(0.5)

        -- H
        log("[H] ContentProvider PreloadAsync", C.YELLOW)
        local rH = methodH_preload(fname)
        log("   => " .. rH, rH:find("OK") and C.GREEN or C.TEXT3)
        task.wait(0.2)

        -- I
        log("[I] Internal video service probe", C.YELLOW)
        local rI = methodI_internal_probe()
        log("   => " .. rI, rI:find("FOUND") and C.YELLOW or C.TEXT3)
        task.wait(0.2)

        -- J
        log("[J] getobjects with custom asset", C.YELLOW)
        local rJ = methodJ_getobjects(fname)
        log("   => " .. rJ, rJ:find("GOT") and C.GREEN or C.TEXT3)
        task.wait(0.2)

        -- final
        log("", C.TEXT)
        log("═══════════════════════════════", C.ACCENT)
        if winner then
            log(">>> METODE " .. winner.src .. " BERHASIL: " .. winner.method, C.GREEN)
            if winner.url then playWinningPreview(winner.url) end
        else
            log(">>> SEMUA METODE GAGAL.", C.RED)
            log("Engine Roblox block video external di level decode pipeline.", C.TEXT3)
            log("Satu-satunya cara play video: upload sebagai Roblox Video asset.", C.TEXT3)
            log("Atau pakai metode OS-level: PiP / split-screen / external player.", C.TEXT3)
        end

        RunBtn.Text = "RUN ALL"
    end

    RunBtn.MouseButton1Click:Connect(function()
        task.spawn(runAll)
    end)

    -- toggle
    local Toggle = Instance.new("TextButton", UI)
    Toggle.Size = UDim2.new(0,36,0,36); Toggle.Position = UDim2.new(0,8,0,210)
    Toggle.BackgroundColor3 = C.BG2; Toggle.BorderSizePixel=0
    Toggle.Text = "MEGA"; Toggle.TextColor3 = C.ACCENT
    Toggle.Font = Enum.Font.GothamBold; Toggle.TextSize = 10
    Instance.new("UICorner", Toggle).CornerRadius = UDim.new(0,8)
    local tgs = Instance.new("UIStroke", Toggle)
    tgs.Color = C.ACCENT; tgs.Thickness = 1
    Toggle.MouseButton1Click:Connect(function() Main.Visible = not Main.Visible end)
end

buildUI()
