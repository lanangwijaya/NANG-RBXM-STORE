--========================================================
-- BUTTON FUNCTION
--========================================================

local function Button(text,y)

    local B = Instance.new("TextButton")

    B.Size = UDim2.new(1,-24,0,36)
    B.Position = UDim2.fromOffset(12,y)

    B.BackgroundColor3 = Color3.fromRGB(38,38,38)
    B.BorderSizePixel = 0

    B.Text = text
    B.TextColor3 = Color3.new(1,1,1)
    B.TextSize = 12
    B.Font = Enum.Font.GothamBold

    B.AutoButtonColor = true
    B.Parent = Main

    local C = Instance.new("UICorner")
    C.CornerRadius = UDim.new(0,8)
    C.Parent = B

    return B
end

local AnchorAll = Button("ANCHOR ALL",84)
local Unanchor = Button("UNANCHOR SELECTED",126)

--========================================================
-- SELECT TOGGLE
--========================================================

local SelectToggle = Button("SELECT MODE : OFF",168)

--========================================================
-- ANCHOR ALL
--========================================================

AnchorAll.MouseButton1Click:Connect(function()

    local count = 0

    for _,obj in ipairs(Workspace:GetDescendants()) do

        if obj:IsA("BasePart") then

            pcall(function()
                obj.Anchored = true
                count = count + 1
            end)

        end

    end

    Status.Text = "Anchored: "..count.." parts"

end)

--========================================================
-- SELECTION
--========================================================

local Selecting = false
local Selected = nil

local Highlight = Instance.new("Highlight")
Highlight.Name = "NANG_Selected"
Highlight.FillTransparency = 0.75
Highlight.OutlineTransparency = 0
Highlight.Enabled = false
Highlight.Parent = Gui

-- Mouse
local Mouse = Player:GetMouse()

SelectToggle.MouseButton1Click:Connect(function()

    Selecting = not Selecting

    if Selecting then

        SelectToggle.Text = "SELECT MODE : ON"
        Status.Text = "Tap / click an object"

    else

        SelectToggle.Text = "SELECT MODE : OFF"
        Selected = nil
        Highlight.Adornee = nil
        Highlight.Enabled = false
        Status.Text = "Ready"

    end

end)

Mouse.Button1Down:Connect(function()

    if not Selecting then
        return
    end

    local Target = Mouse.Target

    if not Target then
        return
    end

    local Object = Target

    local Model = Target:FindFirstAncestorOfClass("Model")

    if Model then
        Object = Model
    end

    Selected = Object

    Highlight.Adornee = Object
    Highlight.Enabled = true

    Status.Text = "Selected: "..Object.Name

end)

--========================================================
-- UNANCHOR SELECTED
--========================================================

Unanchor.MouseButton1Click:Connect(function()

    if not Selected then
        Status.Text = "Nothing selected"
        return
    end

    local count = 0

    if Selected:IsA("BasePart") then

        pcall(function()
            Selected.Anchored = false
            count = count + 1
        end)

    end

    for _,obj in ipairs(Selected:GetDescendants()) do

        if obj:IsA("BasePart") then

            pcall(function()
                obj.Anchored = false
                count = count + 1
            end)

        end

    end

    Status.Text = "Unanchored: "..count.." parts"

end)

--========================================================
-- MINIMIZE
--========================================================

local Minimized = false

Min.MouseButton1Click:Connect(function()

    Minimized = not Minimized

    if Minimized then

        Main.Size = UDim2.fromOffset(175,45)

        Title.Text = "ANCHOR • BY NANG"

        By.Visible = false
        Status.Visible = false
        AnchorAll.Visible = false
        Unanchor.Visible = false
        SelectToggle.Visible = false

        Min.Text = "+"

    else

        Main.Size = UDim2.fromOffset(250,190)

        Title.Text = "ANCHOR CONTROL"

        By.Visible = true
        Status.Visible = true
        AnchorAll.Visible = true
        Unanchor.Visible = true
        SelectToggle.Visible = true

        Min.Text = "−"

    end

end)

--========================================================
-- DRAG
--========================================================

local Dragging = false
local DragStart
local StartPosition

local function StartDrag(input)

    Dragging = true
    DragStart = input.Position
    StartPosition = Main.Position

end

local function UpdateDrag(input)

    if not Dragging then
        return
    end

    local Delta = input.Position - DragStart

    Main.Position = UDim2.new(
        StartPosition.X.Scale,
        StartPosition.X.Offset + Delta.X,
        StartPosition.Y.Scale,
        StartPosition.Y.Offset + Delta.Y
    )

end

Title.InputBegan:Connect(function(input)

    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then

        StartDrag(input)

    end

end)

UIS.InputChanged:Connect(function(input)

    if input.UserInputType == Enum.UserInputType.MouseMovement
    or input.UserInputType == Enum.UserInputType.Touch then

        UpdateDrag(input)

    end

end)

UIS.InputEnded:Connect(function(input)

    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then

        Dragging = false

    end

end)

--========================================================
-- DONE
--========================================================

print("[NANG] Anchor Control Loaded")
