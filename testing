    -- ═══════════════════════════════════════════════════════════════════
    -- SEARCH RUNNER
    -- ═══════════════════════════════════════════════════════════════════
    local busySearch = false
    local function runSearch()
        if busySearch then return end
        if tostring(SearchBox.Text):gsub("%s+","") == "" then
            notify("Perhatian", "Ketik nama asset dulu.", Color3.fromRGB(220,200,150))
            return
        end
        busySearch = true
        SearchBtn.Text = "MENCARI..."
        SearchBtn.BackgroundColor3 = Color3.fromRGB(90,90,90)
        clearResults()
        EmptyFrame.Visible = true
        EmptyLabel.Text = "⏳ Mencari "..SearchType.." di Creator Store...\n\nMenarik sampai 5 halaman (~150 hasil)."
        StatsText.Text = "Status: Mencari "..SearchType.."..."

        task.spawn(function()
            local ok, res = searchCreator(SearchBox.Text, SearchType)
            if ok then
                EmptyFrame.Visible = (#res == 0)
                if #res == 0 then
                    EmptyLabel.Text = SearchType.." tidak ditemukan.\nCoba kata kunci lain."
                    StatsText.Text = "Status: Tidak ada hasil"
                else
                    for _, info in ipairs(res) do buildResultCard(info) end
                    StatsText.Text = string.format("Status: Selesai  |  %d %s ditemukan", #res, SearchType)
                    notify("Berhasil!", #res.." "..SearchType.." ditemukan.", Color3.fromRGB(150,200,150))
                end
            else
                EmptyFrame.Visible = true
                EmptyLabel.Text = "Pencarian gagal.\n"..tostring(res)
                notify("Gagal", tostring(res), Color3.fromRGB(200,120,120))
                StatsText.Text = "Status: Gagal"
            end
            SearchBtn.Text = "CARI"
            SearchBtn.BackgroundColor3 = Color3.fromRGB(130,130,130)
            busySearch = false
        end)
    end
    SearchBtn.MouseButton1Click:Connect(runSearch)
    SearchBox.FocusLost:Connect(function(enter) if enter then runSearch() end end)

