-- ═══════════════════════════════════════════════════════════════════════
-- 1. ANTI-KICK / ANTI-REJOIN
-- block Kick, Teleport, Disconnect via metatable hook
-- ═══════════════════════════════════════════════════════════════════════
local KICK_LOG = {}
local ANTI_ON = true

if getrawmetatable and setreadonly then
    local mt = getrawmetatable(game)
    local oldNC = mt.__namecall
    setreadonly(mt, false)
    mt.__namecall = newcclosure(function(self, ...)
        local method = getnamecallmethod()
        if not ANTI_ON then return oldNC(self, ...) end

        -- block kick
        if (method == "Kick") and self == LP then
            table.insert(KICK_LOG, { time = os.clock(), msg = "Kick blocked" })
            warn("[ANTI] Kick attempt blocked")
            return nil
        end

        -- block teleport ke place lain (rejoin/redirect)
        if (method == "Teleport" or method == "TeleportToPlaceInstance" or method == "TeleportAsync")
        and (self == game:GetService("TeleportService") or typeof(self) == "Instance") then
            local args = {...}
            local dest = args[1]
            if dest and tostring(dest) ~= tostring(game.PlaceId) then
                table.insert(KICK_LOG, { time = os.clock(), msg = "Teleport blocked to " .. tostring(dest) })
                warn("[ANTI] Teleport attempt blocked to " .. tostring(dest))
                return nil
            end
        end

        return oldNC(self, ...)
    end)
    setreadonly(mt, true)
    print("[ANTI] Kick/Teleport block: ON")
else
    warn("[ANTI] executor nggak support metatable hook — anti-rejoin OFF")
end

-- block via service signals juga
pcall(function()
    game:GetService("TeleportService").TeleportInitFailed:Connect(function()
        warn("[ANTI] Teleport init failed — ignoring")
    end)
end)

-- keep connection alive — re-fire join biasa kalau game nyoba rejoin
