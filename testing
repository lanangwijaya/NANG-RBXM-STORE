-- SEARCH RUNNER
-- ═══════════════════════════════════════════════════════════════════════
local creatorSearching = false

local function runCreatorSearch()
    if creatorSearching then return end
    local keyword = SearchModelBox.Text
    if tostring(keyword):gsub("%s+", "") == "" then
        notify("Perhatian", "Ketik nama asset dulu sebelum cari.", Color3.fromRGB(220,200,150))
        return
    end

    creatorSearching = true
    SearchModelBtn.Text = "MENCARI..."
    SearchModelBtn.BackgroundColor3 = Color3.fromRGB(90,90,90)
    clearScrollCards()
    SearchEmptyFrame.Visible = true
    SearchEmptyFrame:FindFirstChildOfClass("TextLabel").Text = "⏳ Mencari " .. SearchType .. " di Creator Store...\n\nMohon tunggu, sedang menarik sampai 5 halaman."
    StatsText.Text = "Status: Mencari " .. SearchType .. " di Creator Store..."

    task.spawn(function()
        local ok, results, err = searchCreatorModels(keyword, 0, SearchType)
        if ok then
            SearchEmptyFrame.Visible = (#results == 0)
            if #results == 0 then
                SearchEmptyFrame:FindFirstChildOfClass("TextLabel").Text = SearchType .. " tidak ditemukan.\nCoba kata kunci lain."
                StatsText.Text = "Status: Tidak ada hasil"
            else
                for _, info in ipairs(results) do buildModelResultCard(info) end
                StatsText.Text = string.format("Status: Selesai  |  %d %s ditemukan", #results, SearchType)
                notify("Berhasil!", #results .. " " .. SearchType .. " ditemukan.", Color3.fromRGB(150,200,150))
            end
        else
            SearchEmptyFrame.Visible = true
            SearchEmptyFrame:FindFirstChildOfClass("TextLabel").Text = "Pencarian gagal.\n" .. tostring(err)
            notify("Gagal", tostring(err), Color3.fromRGB(200,120,120))
            StatsText.Text = "Status: Pencarian gagal"
        end
        SearchModelBtn.Text = "CARI"
        SearchModelBtn.BackgroundColor3 = Color3.fromRGB(130,130,130)
        creatorSearching = false
    end)
end

SearchModelBtn.MouseButton1Click:Connect(runCreatorSearch)
SearchModelBox.FocusLost:Connect(function(enterPressed)
    if enterPressed then runCreatorSearch() end
end)

